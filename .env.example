# ===== Enterprise (multi-tenant) platform: environment variables =====
# Use a NEW Turso database for this product (never the Trinity one).

# Database (Turso): dashboard > database > Connect
TURSO_DATABASE_URL=libsql://your-new-database-yourorg.turso.io
TURSO_AUTH_TOKEN=

# Signs the login cookie. 16+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Password for the platform-owner console at /platform (8+ characters, long and unique)
PLATFORM_ADMIN_PASSWORD=

# NOT used any more in this version: TEACHER_PASSWORD (teachers now have their own accounts per institution)
